{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-lens.dev/contracts/method-manifest.schema.json",
  "title": "Data Lens Method Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "method_id", "version", "status", "name",
    "question_types", "accepted_units", "input_shapes", "eligibility_checks",
    "human_gates", "implementation", "outputs", "evidence_requirements",
    "allowed_claims", "forbidden_claims", "validation"
  ],
  "properties": {
    "contract_version": {"const": "data-lens-method-manifest/1.0"},
    "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["experimental", "validated", "published", "deprecated", "retired"]},
    "name": {"type": "string", "minLength": 2},
    "question_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "accepted_units": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "input_shapes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "eligibility_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_gates": {"type": "array", "items": {"type": "string"}},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "entrypoint", "network_policy"],
      "properties": {
        "runtime": {"enum": ["python", "r", "host_agent", "hybrid"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "network_policy": {"enum": ["deny", "explicit_authorization_required"]},
        "optional_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fixtures"],
      "properties": {
        "status": {"enum": ["fixture_only", "regression_tested", "human_reviewed", "benchmark_reviewed"]},
        "fixtures": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
