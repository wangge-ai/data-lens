{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-lens.dev/contracts/deep-analysis-execution.schema.json",
  "title": "Data Lens Deep Analysis Execution 0.2 (legacy 0.1 accepted)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "execution_id", "decision_question", "analysis_binding", "data_source", "data_evidence_refs"],
  "properties": {
    "contract_version": {"enum": ["data-lens-deep-analysis-execution/0.1", "data-lens-deep-analysis-execution/0.2"]},
    "execution_id": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "analysis_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_layer", "target", "validation_type", "method", "component_id", "analysis_unit", "outcome_field"],
      "properties": {
        "analysis_layer": {"enum": ["heterogeneity", "mechanism", "predictive", "decision"]},
        "target": {"type": "string", "minLength": 1},
        "validation_type": {"enum": ["subgroup_analysis", "direct_mechanism_test", "out_of_sample", "policy_evaluation"]},
        "method": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "analysis_unit": {"type": "string", "minLength": 1},
        "outcome_field": {"type": "string", "minLength": 1},
        "segment_field": {"type": "string", "minLength": 1},
        "group_field": {"type": "string", "minLength": 1},
        "group_a": {},
        "group_b": {},
        "minimum_group_n": {"type": "integer", "minimum": 2},
        "effect_scope": {"enum": ["descriptive", "causal"]},
        "design_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "validation_mode": {"enum": ["prespecified", "honest_split"]},
        "split_field": {"type": "string", "minLength": 1},
        "discovery_value": {},
        "estimation_value": {},
        "unit_id_field": {"type": "string", "minLength": 1},
        "discovery_min_group_n": {"type": "integer", "minimum": 2},
        "estimation_min_group_n": {"type": "integer", "minimum": 2},
        "discovery_min_abs_difference": {"type": "number", "minimum": 0},
        "max_selected_subgroups": {"type": "integer", "minimum": 2},
        "minimum_confirmed_subgroups": {"type": "integer", "minimum": 2},
        "selection_metric": {"const": "absolute_difference"},
        "confirmation_rule": {"const": "same_direction_and_interval_excludes_zero"},
        "mechanism_id": {"type": "string", "minLength": 1},
        "mechanism_variable": {"type": "string", "minLength": 1},
        "changed_or_isolated_variable": {"type": "string", "minLength": 1},
        "baseline_hypothesis_id": {"type": "string", "minLength": 1},
        "candidate_hypothesis_id": {"type": "string", "minLength": 1},
        "required_granularity": {"type": "string", "minLength": 1},
        "evaluation_window": {"type": "object"},
        "measurement": {"type": "object"},
        "hypothesis_predictions": {"type": "object"},
        "validation_design": {"enum": ["rolling_origin"]},
        "time_field": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "horizon_steps": {"type": "integer", "minimum": 1},
        "horizon_unit": {"type": "string", "minLength": 1},
        "cutoff": {"type": "string", "minLength": 1},
        "cutoff_mode": {"enum": ["rolling_origin"]},
        "metric": {"enum": ["mae", "rmse", "MAE", "RMSE"]},
        "baseline_model": {"type": "string", "minLength": 1},
        "baseline_kind": {"type": "string", "minLength": 1},
        "minimum_history": {"type": "integer", "minimum": 2},
        "minimum_improvement": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty_method": {"const": "circular_block_bootstrap"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_replicates": {"type": "integer", "minimum": 200},
        "bootstrap_seed": {"type": "integer"},
        "block_length": {"type": "integer", "minimum": 1},
        "minimum_origins": {"type": "integer", "minimum": 5},
        "baseline_model_id": {"type": "string", "minLength": 1},
        "model_specs": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "evidence_basis": {"enum": ["causal_effect", "prediction", "descriptive_rule"]},
        "actor": {"type": "string", "minLength": 1},
        "action_field": {"type": "string", "minLength": 1},
        "action_options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "benefit_field": {"type": "string", "minLength": 1},
        "cost_field": {"type": "string", "minLength": 1},
        "probability_field": {"type": "string"},
        "weight_field": {"type": "string"},
        "baseline_action": {"type": "string", "minLength": 1},
        "fallback_action": {"type": "string", "minLength": 1},
        "utility_metric": {"type": "string", "minLength": 1},
        "decision_threshold": {"type": "string", "minLength": 1},
        "evaluation_mode": {"enum": ["scenario_utility", "logged_policy"]},
        "minimum_net_utility": {"type": "number"},
        "minimum_advantage": {"type": "number"},
        "constraint_rules": {"type": "array", "items": {"type": "object"}},
        "logged_action_field": {"type": "string", "minLength": 1},
        "action_values": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reward_field": {"type": "string", "minLength": 1},
        "propensity_field": {"type": "string", "minLength": 1},
        "bootstrap_unit_field": {"type": "string", "minLength": 1},
        "estimators": {"type": "array", "minItems": 1, "items": {"enum": ["ips", "snips", "doubly_robust"]}, "uniqueItems": true},
        "primary_estimator": {"enum": ["ips", "snips", "doubly_robust"]},
        "q_logged_field": {"type": "string", "minLength": 1},
        "policy_specs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_id", "policy_type"],
            "properties": {
              "policy_id": {"type": "string", "minLength": 1},
              "policy_type": {"enum": ["explicit_probabilities", "logging_policy", "uniform_policy"]},
              "action_probability_fields": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "q_policy_field": {"type": "string", "minLength": 1}
            }
          }
        },
        "minimum_effective_sample_size": {"type": "number", "exclusiveMinimum": 0},
        "maximum_importance_weight": {"type": "number", "exclusiveMinimum": 0},
        "weight_clip_grid": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}, "uniqueItems": true},
        "propensity_floor_grid": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "uniqueItems": true},
        "withdrawal_condition": {"type": "string", "minLength": 1}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "granularity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["csv", "json"]},
        "granularity": {"type": "string", "minLength": 1},
        "time_field": {"type": "string", "minLength": 1}
      }
    },
    "data_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
