{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-lens.dev/contracts/deep-evidence-cards.schema.json",
  "title": "Data Lens Deep Evidence Cards 1.0",
  "type": "object",
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "source", "source_sha256", "locator", "unit_id", "independence_group", "family_id", "lane", "directness"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "locator": {"type": "object"},
          "verified": {"type": "boolean"},
          "status": {"type": "string"},
          "unit_id": {"type": "string", "minLength": 1},
          "independence_group": {"type": "string", "minLength": 1},
          "family_id": {"type": "string", "minLength": 1},
          "lane": {"type": "string", "minLength": 1},
          "directness": {"enum": ["direct", "derived", "source_stated"]},
          "design_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["analysis_unit", "outcome_name", "outcome_field", "intervention", "comparator", "group_field", "intervention_value", "comparator_value", "assignment_mechanism", "identification_strategy", "estimand", "estimator"],
            "properties": {
              "analysis_unit": {"type": "string", "minLength": 1},
              "outcome_name": {"type": "string", "minLength": 1},
              "outcome_field": {"type": "string", "minLength": 1},
              "intervention": {"type": "string", "minLength": 1},
              "comparator": {"type": "string", "minLength": 1},
              "group_field": {"type": "string", "minLength": 1},
              "intervention_value": {},
              "comparator_value": {},
              "assignment_mechanism": {"enum": ["randomized", "as_if_random", "observational", "unknown"]},
              "identification_strategy": {"type": "string", "minLength": 1},
              "estimand": {"type": "string", "minLength": 1},
              "estimator": {"type": "string", "minLength": 1}
            }
          },
          "identification_check_binding": {
            "type": "object",
            "additionalProperties": true,
            "required": ["check_name", "status"],
            "properties": {
              "check_name": {"type": "string", "minLength": 1},
              "status": {"enum": ["supported", "uncertain", "violated"]}
            }
          },
          "result_contract_version": {"type": "string", "minLength": 1},
          "result_status": {"enum": ["completed", "succeeded"]},
          "caveat": {"type": ["string", "null"]}
        }
      }
    }
  }
}
