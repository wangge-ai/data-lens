{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-lens.dev/contracts/hypothesis-experiment.schema.json",
  "title": "Data Lens Hypothesis Experiment 0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_version", "experiment_id", "decision_question", "mode", "data_source"],
  "properties": {
    "contract_version": {"const": "data-lens-hypothesis-experiment/0.1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "mode": {"enum": ["atomic_claims", "hypothesis_comparison"]},
    "analysis_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_layer", "target", "validation_type", "method", "component_id", "design_evidence_refs"],
      "properties": {
        "analysis_layer": {"enum": ["predictive", "causal", "decision"]},
        "target": {"type": "string", "minLength": 1},
        "validation_type": {"enum": ["out_of_sample", "randomized_experiment", "identified_observational_estimate", "decision_analysis", "policy_evaluation"]},
        "method": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "design_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outcome_field": {"type": "string", "minLength": 1},
        "identification_strategy": {"type": "string", "minLength": 1},
        "intervention": {"type": "string", "minLength": 1},
        "comparator": {"type": "string", "minLength": 1},
        "group_field": {"type": "string", "minLength": 1},
        "intervention_value": {},
        "comparator_value": {},
        "validation_design": {"enum": ["rolling_origin", "future_holdout"]},
        "horizon": {"type": "string", "minLength": 1},
        "horizon_steps": {"type": "integer", "minimum": 1},
        "horizon_unit": {"type": "string", "minLength": 1},
        "cutoff": {"type": "string", "minLength": 1},
        "cutoff_mode": {"enum": ["rolling_origin", "fixed_holdout"]},
        "metric": {"type": "string", "minLength": 1},
        "baseline_model": {"type": "string", "minLength": 1},
        "baseline_kind": {"enum": ["last_observation", "seasonal_naive", "median_interval", "custom"]},
        "evidence_basis": {"enum": ["causal_effect", "prediction", "descriptive_rule"]},
        "utility_metric": {"type": "string", "minLength": 1},
        "decision_threshold": {"type": "string", "minLength": 1}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["granularity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["csv", "json"]},
        "rows": {"type": "array", "items": {"type": "object"}},
        "granularity": {
          "enum": ["tick", "intraday_1m", "intraday_5m", "intraday_15m", "intraday_30m", "intraday_60m", "daily", "weekly", "monthly", "quarterly", "yearly"]
        },
        "time_field": {"type": "string", "minLength": 1}
      }
    },
    "declared_dimensions": {
      "type": "array",
      "items": {"enum": ["direction", "time", "point", "path", "invalidation"]},
      "uniqueItems": true
    },
    "components": {"type": "array", "items": {"type": "object"}},
    "candidate_id": {"type": "string", "minLength": 1},
    "data_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "candidate_core_mechanism": {"type": "string", "minLength": 1},
    "target_mechanism": {"type": "string", "minLength": 1},
    "mechanism_variable": {"type": "string", "minLength": 1},
    "changed_or_isolated_variable": {"type": "string", "minLength": 1},
    "measurement_window_claim": {"type": "string", "minLength": 1},
    "distinguishing_observation": {"type": "string", "minLength": 1},
    "baseline_hypothesis_id": {"type": "string", "minLength": 1},
    "candidate_hypothesis_id": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "items": {"type": "object"}},
    "required_granularity": {"type": "string", "minLength": 1},
    "evaluation_window": {"type": "object"},
    "measurement": {"type": "object"}
  }
}
